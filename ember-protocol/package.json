{
  "name": "ember-protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write src tests vite.config.ts",
    "format:check": "prettier --check src tests vite.config.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
